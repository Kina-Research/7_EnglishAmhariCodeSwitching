# =============================================================================
# EthioSwitch-Bench .gitignore
# =============================================================================

# --- Python environment ---
.venv/
venv/
env/
.env
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.whl

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --- Large private experiment artifacts ---
# These files are generated by the pipeline and may be large or contain
# intermediate data not suitable for public release. Run pipeline.py to reproduce.
code/data/pipeline.log
code/data/model_outputs.json
code/data/auto_eval_results.json
code/data/human_eval_results.json
code/data/human_eval_template.csv

# --- Logs ---
*.log
logs/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- LaTeX build artifacts ---
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv

# --- Test / temporary ---
.pytest_cache/
.coverage
htmlcov/
*.tmp
*.bak

# --- OS-specific ---
desktop.ini
